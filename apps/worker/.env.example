# 可选 HTTP 代理：取消注释并填写本机地址；不配置则直连。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1

LLM_BASE_URL=https://maomiapi.com/v1
LLM_MODEL=gpt-5.6-sol
LLM_API_KEY=replace_with_your_api_key
IMAGE_BASE_URL=https://maomiapi.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_API_KEY=replace_with_your_image_api_key
DATABASE_URL=postgres://ai_chat:ai_chat_local@localhost:5433/ai_chat
# RAG 使用百炼业务空间的 OpenAI 兼容地址，不要填聊天中转地址。
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
REDIS_URL=redis://localhost:6380
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=ai-chat-v2
R2_ACCESS_KEY_ID=replace_with_your_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_your_r2_secret_access_key

# 联网搜索只在用户打开开关时注入；使用 basic 搜索控制免费额度消耗。
TAVILY_API_KEY=replace_with_your_tavily_api_key

# 远程 MCP Server：未配置时不启用，不影响现有 Chat/Image。
FORTUNE_MCP_URL=http://127.0.0.1:3100/mcp
FORTUNE_MCP_API_KEY=replace_with_your_fortune_mcp_api_key
# 百度地图官方 Streamable HTTP MCP；只在服务端环境中保存 AK。
BAIDU_MAPS_API_KEY=replace_with_your_baidu_maps_api_key
