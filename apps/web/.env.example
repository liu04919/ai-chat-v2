# 可选开发代理：启动时探测端口，未配置或不可连接时直连。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1

DATABASE_URL=postgres://ai_chat:ai_chat_local@localhost:5433/ai_chat
TEST_DATABASE_URL=postgres://ai_chat:ai_chat_local@localhost:5433/ai_chat_test
REDIS_URL=redis://localhost:6380
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# 可选第三方登录：始终显示两个入口，同时配置 ID 与 Secret 后才启用对应按钮。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=ai-chat-v2
R2_ACCESS_KEY_ID=replace_with_your_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_your_r2_secret_access_key
FORTUNE_MCP_URL=http://127.0.0.1:3100/mcp
FORTUNE_MCP_API_KEY=replace_with_your_fortune_mcp_api_key
BAIDU_MAPS_API_KEY=replace_with_your_baidu_maps_api_key
