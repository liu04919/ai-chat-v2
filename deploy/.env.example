# 复制为 deploy/.env，真实值只放在服务器，不进入 Git。
# POSTGRES_PASSWORD 使用随机十六进制，避免拼入连接 URL 时需要额外转义。
POSTGRES_PASSWORD=replace_with_random_hex
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:3001
APP_PORT=8080

WEB_IMAGE=ai-chat-web:local
WORKER_IMAGE=ai-chat-worker:local
POSTGRES_IMAGE=ai-chat-postgres:18.4-rag
REDIS_IMAGE=redis:8-alpine
CADDY_IMAGE=caddy:2.10-alpine

LLM_BASE_URL=https://api.a6api.com/v1
LLM_MODEL=gpt-5.6-sol
LLM_API_KEY=replace_with_your_relay_key
IMAGE_BASE_URL=https://api.a6api.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_API_KEY=replace_with_your_relay_key

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=ai-chat-production
R2_ACCESS_KEY_ID=replace_with_your_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_your_r2_secret_access_key
DASHSCOPE_API_KEY=replace_with_your_dashscope_key
EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
RERANK_MODEL=qwen3.7-text-rerank
TAVILY_API_KEY=

# 可选 MCP；线上不能指向你电脑上的 127.0.0.1:3100。
FORTUNE_MCP_URL=
FORTUNE_MCP_API_KEY=
BAIDU_MAPS_API_KEY=
